#!/usr/bin/env ruby

require_relative "../lib/hunch"

key = ENV["OPENROUTER_API_KEY"] || (File.read(File.expand_path(ARGV[0])).strip if ARGV[0])
abort "usage: bin/live_check <path-to-key-file>  (or set OPENROUTER_API_KEY)" unless key

Hunch.configure do |config|
  config.api_key = key
  config.url = "https://openrouter.ai/api/alpha/decisions"
  config.model = "typesafe/jev-1.13"
end

state = "Subject: URGENT - payouts failing\n\nHelp! My payouts have been failing for 3 days and my rent is due. " \
        "If this isn't fixed by Friday I'm moving to your competitor."

result = Hunch.decide(given: state) do |q|
  q.probably? :urgent, "does this convey urgency?"
  q.likely? :churn_risk, "does the sender threaten to leave?"
  q.pick :team, billing: "payments, invoices, refunds", technical: "bugs and outages", sales: "pricing and upgrades"
  q.rate :mood, :calm, :frustrated, :livid
end

puts "model:      #{result.model}"
puts "urgent:     #{result.urgent.round(3)} (at or above :probably? #{result.urgent?})"
puts "churn_risk: #{result.churn_risk.round(3)}"
puts "team:       #{result.team} #{result.team_probabilities.transform_values { |p| p.round(3) }}"
puts "mood:       #{result.mood.inspect} probabilities=#{result.mood.probabilities.transform_values { |p| p.round(3) }}"
puts
puts "single-shot: almost_certainly?(urgency) => #{Hunch.almost_certainly?("does this convey urgency?", given: state)}"
puts "usage:      #{result.usage.inspect}"
